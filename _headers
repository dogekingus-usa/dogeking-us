/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Cache-Control: public, max-age=3600, s-maxage=86400
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://kit.fontawesome.com https://analytics.ahrefs.com https://www.googletagmanager.com https://www.google-analytics.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://kit.fontawesome.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com https://kit.fontawesome.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; connect-src 'self' https://hook.us1.make.com; form-action 'self' https://hook.us1.make.com https://api.kit.com

/*.html
  Cache-Control: public, max-age=3600, s-maxage=86400

/articles/*
  Cache-Control: public, max-age=7200, s-maxage=604800

/blog/*
  Cache-Control: public, max-age=7200, s-maxage=604800

/assets/*
  Cache-Control: public, max-age=31536000, immutable

*.ico
  Cache-Control: public, max-age=604800, immutable

*.svg
  Cache-Control: public, max-age=31536000, immutable

*.css
  Cache-Control: public, max-age=31536000, immutable

*.js
  Cache-Control: public, max-age=31536000, immutable

*.woff2
  Cache-Control: public, max-age=31536000, immutable

*.png
  Cache-Control: public, max-age=31536000, immutable

*.jpg
  Cache-Control: public, max-age=31536000, immutable

*.webp
  Cache-Control: public, max-age=31536000, immutable

*.pdf
  Cache-Control: public, max-age=31536000, immutable
