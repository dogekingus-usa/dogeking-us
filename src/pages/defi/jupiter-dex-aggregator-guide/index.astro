---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "jupiter-dex-aggregator-guide", "title": "How to Use Jupiter DEX Aggregator on Solana", "category": "defi", "date": "2000", "excerpt": "Complete guide to using Jupiter DEX aggregator on Solana. Best swap routes, limit orders, DCA, and advanced trading features.", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="How to Use Jupiter DEX Aggregator on Solana" description="Complete guide to using Jupiter DEX aggregator on Solana. Best swap routes, limit orders, DCA, and advanced trading features.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">How to Use Jupiter DEX Aggregator on Solana</h1>
      <time class="text-sm text-gray-500">2000</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Complete guide to using Jupiter DEX aggregator on Solana. Best swap routes, limit orders, DCA, and advanced trading features.</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
