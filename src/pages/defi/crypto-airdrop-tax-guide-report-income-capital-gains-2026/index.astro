---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "crypto-airdrop-tax-guide-report-income-capital-gains-2026", "title": "Crypto Airdrop Tax Guide 2026: How to Report Airdrop Income and Capital Gains Correctly | DogeKing", "category": "defi", "date": "2026", "excerpt": "Complete 2026 crypto airdrop tax guide. Learn how the IRS treats airdrops as ordinary income, determine FMV at receipt, claim airdrop costs, report...", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Crypto Airdrop Tax Guide 2026: How to Report Airdrop Income and Capital Gains Correctly | DogeKing" description="Complete 2026 crypto airdrop tax guide. Learn how the IRS treats airdrops as ordinary income, determine FMV at receipt, claim airdrop costs, report...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Crypto Airdrop Tax Guide 2026: How to Report Airdrop Income and Capital Gains Correctly | DogeKing</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Complete 2026 crypto airdrop tax guide. Learn how the IRS treats airdrops as ordinary income, determine FMV at receipt, claim airdrop costs, report...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
