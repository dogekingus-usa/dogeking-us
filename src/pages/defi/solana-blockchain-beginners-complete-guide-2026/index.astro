---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "solana-blockchain-beginners-complete-guide-2026", "title": "Solana Blockchain 101: Complete Beginner's Guide to Solana in 2026 | DogeKing", "category": "defi", "date": "2026", "excerpt": "New to Solana? This complete beginner's guide covers what Solana is, how proof-of-history works, SOL token utility, best wallets, how to buy SOL, S...", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Solana Blockchain 101: Complete Beginner's Guide to Solana in 2026 | DogeKing" description="New to Solana? This complete beginner's guide covers what Solana is, how proof-of-history works, SOL token utility, best wallets, how to buy SOL, S...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Solana Blockchain 101: Complete Beginner's Guide to Solana in 2026 | DogeKing</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>New to Solana? This complete beginner's guide covers what Solana is, how proof-of-history works, SOL token utility, best wallets, how to buy SOL, S...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
