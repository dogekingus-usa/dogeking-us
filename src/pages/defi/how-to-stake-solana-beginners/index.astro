---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "how-to-stake-solana-beginners", "title": "How to Stake Solana: A Complete Guide for Beginners", "category": "defi", "date": "2000", "excerpt": "Learn how to stake Solana tokens. Earn passive income through staking with this beginner-friendly step-by-step guide.", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="How to Stake Solana: A Complete Guide for Beginners" description="Learn how to stake Solana tokens. Earn passive income through staking with this beginner-friendly step-by-step guide.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">How to Stake Solana: A Complete Guide for Beginners</h1>
      <time class="text-sm text-gray-500">2000</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Learn how to stake Solana tokens. Earn passive income through staking with this beginner-friendly step-by-step guide.</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
