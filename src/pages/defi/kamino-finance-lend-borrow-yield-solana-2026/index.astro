---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "kamino-finance-lend-borrow-yield-solana-2026", "title": "Kamino Finance 2026 Guide: How to Lend, Borrow, and Earn Yield on Solana", "category": "defi", "date": "2026", "excerpt": "Complete guide to Kamino Finance on Solana. Learn how to lend tokens for APY, borrow against collateral, and optimize yields using Kamino Lend, Multiply, and automated vault strategies for 2026.", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Kamino Finance 2026 Guide: How to Lend, Borrow, and Earn Yield on Solana" description="Complete guide to Kamino Finance on Solana. Learn how to lend tokens for APY, borrow against collateral, and optimize yields using Kamino Lend, Multiply, and automated vault strategies for 2026.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Kamino Finance 2026 Guide: How to Lend, Borrow, and Earn Yield on Solana</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Complete guide to Kamino Finance on Solana. Learn how to lend tokens for APY, borrow against collateral, and optimize yields using Kamino Lend, Multiply, and automated vault strategies for 2026.</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
