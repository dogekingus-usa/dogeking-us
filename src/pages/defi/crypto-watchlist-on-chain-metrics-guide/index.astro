---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "crypto-watchlist-on-chain-metrics-guide", "title": "How to Build a Crypto Watchlist: On-Chain Metrics Guide", "category": "defi", "date": "2026", "excerpt": "Learn how to build a professional crypto watchlist in 2026. Master on-chain metrics, social signals, entry points, and monitoring tools to track me...", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="How to Build a Crypto Watchlist: On-Chain Metrics Guide" description="Learn how to build a professional crypto watchlist in 2026. Master on-chain metrics, social signals, entry points, and monitoring tools to track me...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">How to Build a Crypto Watchlist: On-Chain Metrics Guide</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Learn how to build a professional crypto watchlist in 2026. Master on-chain metrics, social signals, entry points, and monitoring tools to track me...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
