---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "solana-payments-crypto-real-world-purchases-solana-pay-2026", "title": "Solana Payments 2026: How to Use Crypto for Real-World Purchases with Solana Pay | DogeKing", "category": "defi", "date": "2026", "excerpt": "Solana Pay is transforming real-world payments in 2026. Learn how to use Solana for everyday purchases with USDC, Solana debit cards, and expanding...", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Solana Payments 2026: How to Use Crypto for Real-World Purchases with Solana Pay | DogeKing" description="Solana Pay is transforming real-world payments in 2026. Learn how to use Solana for everyday purchases with USDC, Solana debit cards, and expanding...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Solana Payments 2026: How to Use Crypto for Real-World Purchases with Solana Pay | DogeKing</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Solana Pay is transforming real-world payments in 2026. Learn how to use Solana for everyday purchases with USDC, Solana debit cards, and expanding...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
