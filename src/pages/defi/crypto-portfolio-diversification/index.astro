---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "crypto-portfolio-diversification", "title": "Building a Diversified Crypto Portfolio: Sector Allocation, Risk Profiles, and Sample Portfolios \\u2014 Doge King", "category": "defi", "date": "1621", "excerpt": "True crypto diversification goes beyond buying multiple coins. Learn how to diversify across sectors (L1s, DeFi, gaming, AI, RWAs), risk levels, an...", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Building a Diversified Crypto Portfolio: Sector Allocation, Risk Profiles, and Sample Portfolios \u2014 Doge King" description="True crypto diversification goes beyond buying multiple coins. Learn how to diversify across sectors (L1s, DeFi, gaming, AI, RWAs), risk levels, an...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Building a Diversified Crypto Portfolio: Sector Allocation, Risk Profiles, and Sample Portfolios \u2014 Doge King</h1>
      <time class="text-sm text-gray-500">1621</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>True crypto diversification goes beyond buying multiple coins. Learn how to diversify across sectors (L1s, DeFi, gaming, AI, RWAs), risk levels, an...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
