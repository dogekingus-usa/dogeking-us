---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "dogeking", "title": "DogeKing ($DKING) \\u2014 Complete Guide Hub | Tokenomics, Staking, Price & More", "category": "defi", "date": "1111", "excerpt": "The ultimate DogeKing ($DKING) resource hub. Learn about tokenomics, how to buy and sell, staking for passive income, price predictions, roadmap up...", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="DogeKing ($DKING) \u2014 Complete Guide Hub | Tokenomics, Staking, Price & More" description="The ultimate DogeKing ($DKING) resource hub. Learn about tokenomics, how to buy and sell, staking for passive income, price predictions, roadmap up...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">DogeKing ($DKING) \u2014 Complete Guide Hub | Tokenomics, Staking, Price & More</h1>
      <time class="text-sm text-gray-500">1111</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>The ultimate DogeKing ($DKING) resource hub. Learn about tokenomics, how to buy and sell, staking for passive income, price predictions, roadmap up...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
