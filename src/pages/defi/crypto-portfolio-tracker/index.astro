---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "crypto-portfolio-tracker", "title": "Crypto Portfolio Tracker Spreadsheet 2026 | DogeKing", "category": "defi", "date": "2026", "excerpt": "Track all your crypto, DeFi, and NFT holdings in one spreadsheet. Auto-calculates P&L, portfolio allocation, and tax lots.", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Crypto Portfolio Tracker Spreadsheet 2026 | DogeKing" description="Track all your crypto, DeFi, and NFT holdings in one spreadsheet. Auto-calculates P&L, portfolio allocation, and tax lots.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Crypto Portfolio Tracker Spreadsheet 2026 | DogeKing</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Track all your crypto, DeFi, and NFT holdings in one spreadsheet. Auto-calculates P&L, portfolio allocation, and tax lots.</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
