---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "stablecoins-solana-usdc-usdt-defi-strategies-2026", "title": "Stablecoins on Solana 2026: USDC, USDT, and DeFi Stablecoin Strategies | DogeKing", "category": "defi", "date": "2026", "excerpt": "Complete guide to stablecoins on Solana in 2026. Compare USDC, USDT, and algorithmic stablecoins, plus yield strategies for earning passive income.", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Stablecoins on Solana 2026: USDC, USDT, and DeFi Stablecoin Strategies | DogeKing" description="Complete guide to stablecoins on Solana in 2026. Compare USDC, USDT, and algorithmic stablecoins, plus yield strategies for earning passive income.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Stablecoins on Solana 2026: USDC, USDT, and DeFi Stablecoin Strategies | DogeKing</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Complete guide to stablecoins on Solana in 2026. Compare USDC, USDT, and algorithmic stablecoins, plus yield strategies for earning passive income.</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
