---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "what-is-solana-blockchain", "title": "What Is Solana? A Beginner's Guide to the High-Speed Blockchain", "category": "defi", "date": "2000", "excerpt": "Learn what Solana is, how it works, and why it matters. Beginner-friendly guide to Solana's technology, SOL token, and ecosystem.", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="What Is Solana? A Beginner's Guide to the High-Speed Blockchain" description="Learn what Solana is, how it works, and why it matters. Beginner-friendly guide to Solana's technology, SOL token, and ecosystem.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">What Is Solana? A Beginner's Guide to the High-Speed Blockchain</h1>
      <time class="text-sm text-gray-500">2000</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Learn what Solana is, how it works, and why it matters. Beginner-friendly guide to Solana's technology, SOL token, and ecosystem.</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
