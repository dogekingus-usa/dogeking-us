---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "liquidity-pools-solana-provide-liquidity-earn-fees-dexs-2026", "title": "Liquidity Pools on Solana: How to Provide Liquidity and Earn Fees on DEXs in 2026 | DogeKing", "category": "defi", "date": "2026", "excerpt": "Complete guide to liquidity pools on Solana. Learn how to provide liquidity on Raydium, Orca, and Meteora, earn trading fees, and manage impermanen...", "tags": ["defi"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Liquidity Pools on Solana: How to Provide Liquidity and Earn Fees on DEXs in 2026 | DogeKing" description="Complete guide to liquidity pools on Solana. Learn how to provide liquidity on Raydium, Orca, and Meteora, earn trading fees, and manage impermanen...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Liquidity Pools on Solana: How to Provide Liquidity and Earn Fees on DEXs in 2026 | DogeKing</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">defi</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Complete guide to liquidity pools on Solana. Learn how to provide liquidity on Raydium, Orca, and Meteora, earn trading fees, and manage impermanen...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
