---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/solana-real-world-assets-rwas-tokenized-2026.html?raw';

const title = "Solana Real World Assets (RWAs): How Traditional Assets Are Tokenized on Solana in 2026 | DogeKing";
const description = "Comprehensive guide to Solana Real World Assets (RWAs) in 2026. How traditional assets like Treasuries, real estate, commodities, and private credit are being tokenized on Solana. Top protocols including Maple Finance, Pando, Parcl, Ondo Finance, and more. Yield comparison vs crypto-collateralized DeFi, risks, and how to invest.";
const canonical = 'https://dogeking.us/solana-real-world-assets-rwas-tokenized-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>