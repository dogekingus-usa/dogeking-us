---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/meme-coin-position-sizing-risk-management.html?raw';

const title = "Meme Coin Position Sizing \u0026 Risk Management: Complete Guide";
const description = "Master meme coin risk management with our complete position sizing guide for 2026. Learn the 1-5% rule, Kelly Criterion, stop-losses, and how to protect your portfolio from catastrophic losses.";
const canonical = 'https://dogeking.us/meme-coin-position-sizing-risk-management';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>