---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/cex-vs-dex-centralized-decentralized-exchanges-meme-coin-trading-2026.html?raw';

const title = "CEX vs DEX on Solana: Centralized vs Decentralized Exchanges for Meme Coin Trading in 2026 | DogeKing";
const description = "CEX vs DEX on Solana in 2026: Compare Coinbase and Kraken vs Jupiter and Raydium for meme coin trading. Fees, speed, security, KYC, liquidity, and token availability analyzed side-by-side.";
const canonical = 'https://dogeking.us/cex-vs-dex-centralized-decentralized-exchanges-meme-coin-trading-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>