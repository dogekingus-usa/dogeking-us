---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/dogeking-price-prediction-2026-2030.html?raw';

const title = "DogeKing Price Prediction 2026-2030: $DKING Market Cap Forecast \u0026 Growth Projections";
const description = "DogeKing ($DKING) price prediction 2026-2030 with detailed market cap analysis, burn rate projections, Solana meme coin sector growth, and realistic price targets for investors.";
const canonical = 'https://dogeking.us/dogeking-price-prediction-2026-2030';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>