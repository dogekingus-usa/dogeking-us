---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/liquidity-pools-solana-provide-liquidity-earn-fees-dexs-2026.html?raw';

const title = "Liquidity Pools on Solana: How to Provide Liquidity and Earn Fees on DEXs in 2026 | DogeKing";
const description = "Complete guide to liquidity pools on Solana. Learn how to provide liquidity on Raydium, Orca, and Meteora, earn trading fees, and manage impermanent loss in 2026.";
const canonical = 'https://dogeking.us/liquidity-pools-solana-provide-liquidity-earn-fees-dexs-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>