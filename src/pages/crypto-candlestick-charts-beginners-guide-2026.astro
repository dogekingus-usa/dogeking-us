---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-candlestick-charts-beginners-guide-2026.html?raw';

const title = "How to Read Crypto Candlestick Charts: A Beginner\u0027s Guide to Technical Analysis for Meme Coin Traders — Doge King";
const description = "Learn how to read crypto candlestick charts in 2026. Complete beginner\u0027s guide to technical analysis for meme coin traders on Solana. Candle patterns, indicators, and trading strategies.";
const canonical = 'https://dogeking.us/crypto-candlestick-charts-beginners-guide-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>