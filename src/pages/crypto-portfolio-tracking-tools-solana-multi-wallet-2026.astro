---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-portfolio-tracking-tools-solana-multi-wallet-2026.html?raw';

const title = "Crypto Portfolio Tracking on Solana: Best Tools for Managing Multi-Wallet Portfolios in 2026 | DogeKing";
const description = "Complete 2026 guide to crypto portfolio tracking on Solana. Compare Step Finance, Sonar Watch, Apeboard, CoinGecko, and CoinMarketCap for multi-wallet tracking, Phantom/Solflare integration, and tax reporting.";
const canonical = 'https://dogeking.us/crypto-portfolio-tracking-tools-solana-multi-wallet-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>