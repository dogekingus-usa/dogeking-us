---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/meme-coin-airdrop-farming-guide-2026.html?raw';

const title = "Meme Coin Airdrop Farming: How to Get Free Tokens Before They Hit the Market in 2026 | DogeKing";
const description = "Complete guide to meme coin airdrop farming in 2026. Learn how to identify airdrop opportunities, qualify for free token drops, avoid scams, and maximize your crypto airdrop earnings on Solana and Ethereum.";
const canonical = 'https://dogeking.us/meme-coin-airdrop-farming-guide-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>