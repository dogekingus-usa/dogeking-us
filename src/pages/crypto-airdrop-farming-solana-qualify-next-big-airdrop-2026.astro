---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-airdrop-farming-solana-qualify-next-big-airdrop-2026.html?raw';

const title = "Crypto Airdrop Farming on Solana: How to Qualify for the Next Big Airdrop in 2026 | DogeKing";
const description = "Master Solana airdrop farming in 2026. Learn qualifying criteria, wallet strategies, Sybil avoidance, gas optimization, and how to use airdrop trackers to never miss a token drop again.";
const canonical = 'https://dogeking.us/crypto-airdrop-farming-solana-qualify-next-big-airdrop-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>