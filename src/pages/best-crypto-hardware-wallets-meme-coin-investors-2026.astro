---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/best-crypto-hardware-wallets-meme-coin-investors-2026.html?raw';

const title = "Best Crypto Hardware Wallets for Meme Coin Investors in 2026";
const description = "Compare the best crypto hardware wallets for meme coin investors in 2026. Ledger vs Trezor, Solana-compatible cold storage, security best practices, and price comparison. Secure your DOGE, SHIB, PEPE and more.";
const canonical = 'https://dogeking.us/best-crypto-hardware-wallets-meme-coin-investors-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>