---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/solana-nft-trading-strategies-floor-sweeping-trait-arbitrage-flipping-2026.html?raw';

const title = "Solana NFT Trading Strategies: Floor Sweeping, Trait Arbitrage, and Flipping for Profit in 2026 | DogeKing";
const description = "Master Solana NFT trading in 2026. Learn floor sweeping strategies, trait rarity sniping, cross-marketplace arbitrage between Tensor and Magic Eden, flipping new mints, NFT lending, and tax implications.";
const canonical = 'https://dogeking.us/solana-nft-trading-strategies-floor-sweeping-trait-arbitrage-flipping-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>