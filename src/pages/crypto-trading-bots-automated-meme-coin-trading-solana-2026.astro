---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-trading-bots-automated-meme-coin-trading-solana-2026.html?raw';

const title = "Crypto Trading Bots 2026: Best Automated Trading Platforms for Meme Coins on Solana | DogeKing";
const description = "Compare the best crypto trading bots for Solana meme coins in 2026. Telegram bots, Jupiter DCA, sniper bots vs trading bots, honeypot risks, and how to automate your trading strategy on Solana.";
const canonical = 'https://dogeking.us/crypto-trading-bots-automated-meme-coin-trading-solana-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>