---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="DogeKing — Meme Coin Trading Guides" description="Your ultimate guide to meme coin trading on Solana. Guides, tips, and market analysis for DogeKing and Solana meme coins.">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="font-['Orbitron'] text-4xl md:text-5xl font-bold text-yellow-400 mb-4">
        DogeKing
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        Your complete guide to meme coin trading on Solana — guides, tips, and market analysis.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <a href="/crypto-guide/" class="block rounded-xl border border-gray-700 bg-gray-800/50 p-6 hover:border-yellow-500/50 hover:bg-gray-800 transition-all">
        <h2 class="font-['Orbitron'] text-lg font-semibold text-yellow-400 mb-2">Crypto Guide</h2>
        <p class="text-sm text-gray-400">Complete guides for crypto beginners and advanced traders.</p>
      </a>

      <a href="/all-articles/" class="block rounded-xl border border-gray-700 bg-gray-800/50 p-6 hover:border-yellow-500/50 hover:bg-gray-800 transition-all">
        <h2 class="font-['Orbitron'] text-lg font-semibold text-yellow-400 mb-2">Articles</h2>
        <p class="text-sm text-gray-400">All articles, guides, and market analysis.</p>
      </a>

      <a href="/checklist/" class="block rounded-xl border border-gray-700 bg-gray-800/50 p-6 hover:border-yellow-500/50 hover:bg-gray-800 transition-all">
        <h2 class="font-['Orbitron'] text-lg font-semibold text-yellow-400 mb-2">Checklist</h2>
        <p class="text-sm text-gray-400">Due diligence checklist for meme coin investing.</p>
      </a>
    </div>
  </section>
</BaseLayout>
