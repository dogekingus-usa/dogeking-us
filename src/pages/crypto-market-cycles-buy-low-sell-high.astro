---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-market-cycles-buy-low-sell-high.html?raw';

const title = "Crypto Market Cycles Explained: How to Buy Low and Sell High Across Bull \u0026 Bear Markets in 2026 | Doge King";
const description = "Complete guide to crypto market cycles in 2026. Understand accumulation, markup, distribution, and markdown phases. Learn how to position your meme coin and crypto portfolio for maximum returns through every cycle phase.";
const canonical = 'https://dogeking.us/crypto-market-cycles-buy-low-sell-high';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>