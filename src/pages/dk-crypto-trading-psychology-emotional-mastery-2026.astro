---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/dk-crypto-trading-psychology-emotional-mastery-2026.html?raw';

const title = "Crypto Trading Psychology 2026: How to Master Your Emotions — Avoid FOMO, Panic Selling, and Revenge Trading That Wipes Out Meme Coin Portfolios | DogeKing";
const description = "Master crypto trading psychology 2026. Overcome FOMO, panic selling, revenge trading, cognitive biases. Journal templates, rules-based systems, mindfulness.";
const canonical = 'https://dogeking.us/dk-crypto-trading-psychology-emotional-mastery-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>