---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-exchange-comparison-coinbase-binance-kraken-beginners-2026.html?raw';

const title = "How to Use a Crypto Exchange: Coinbase vs Binance vs Kraken for Beginners in 2026 — Doge King";
const description = "Complete beginner\u0027s guide to crypto exchanges in 2026. Compare Coinbase, Binance, and Kraken: fees, features, security, and how to buy your first cryptocurrency step by step.";
const canonical = 'https://dogeking.us/crypto-exchange-comparison-coinbase-binance-kraken-beginners-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>