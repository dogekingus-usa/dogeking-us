---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-spot-crypto-rug-pull-10-red-flags-meme-coin-investor-must-know-2026.html?raw';

const title = "How to Spot a Crypto Rug Pull: 10 Red Flags Every Meme Coin Investor Must Know in 2026";
const description = "Learn the 10 critical red flags of crypto rug pulls in 2026. From liquidity locks to honeypot contracts, protect your meme coin portfolio with this complete investor safety guide.";
const canonical = 'https://dogeking.us/how-to-spot-crypto-rug-pull-10-red-flags-meme-coin-investor-must-know-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>