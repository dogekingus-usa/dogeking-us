---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-whale-watching-solana-track-smart-money-2026.html?raw';

const title = "Crypto Whale Watching on Solana: Complete Guide to Tracking Smart Money \u0026 Copying Whale Trades (2026)";
const description = "Expert guide to crypto whale watching on Solana. Learn how to track whale wallets, spot smart money accumulation, use whale tracking tools, and copy profitable whale trades in 2026.";
const canonical = 'https://dogeking.us/crypto-whale-watching-solana-track-smart-money-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>