---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/solana-etf-2026-complete-guide-approval-price-impact.html?raw';

const title = "Solana ETF 2026: Complete Guide to Approval, Price Impact \u0026 Trading Strategy";
const description = "Solana ETF 2026 complete guide: Current approval status, price impact analysis, how to position your portfolio, and trading strategies for the SOL ETF catalyst.";
const canonical = 'https://dogeking.us/solana-etf-2026-complete-guide-approval-price-impact';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>