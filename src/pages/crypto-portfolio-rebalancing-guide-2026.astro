---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-portfolio-rebalancing-guide-2026.html?raw';

const title = "When to Rebalance Your Crypto Portfolio: A Complete Guide for 2026 | Doge King";
const description = "Complete guide to crypto portfolio rebalancing in 2026. Learn when to sell, when to hold, rebalancing strategies for volatile markets, and how to maintain your target allocation through bull and bear cycles.";
const canonical = 'https://dogeking.us/crypto-portfolio-rebalancing-guide-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>