---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-tax-strategy-2026.html?raw';

const title = "Crypto Tax Strategy 2026: Save Money with Tax-Loss Harvesting \u0026 Reporting | DogeKing.us";
const description = "Master crypto tax strategy for 2026. Tax-loss harvesting, cost basis methods, DeFi tax reporting, and how to minimize your crypto tax bill legally.";
const canonical = 'https://dogeking.us/crypto-tax-strategy-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>