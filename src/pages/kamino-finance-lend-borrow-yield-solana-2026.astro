---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/kamino-finance-lend-borrow-yield-solana-2026.html?raw';

const title = "Kamino Finance 2026 Guide: How to Lend, Borrow, and Earn Yield on Solana";
const description = "Complete guide to Kamino Finance on Solana in 2026. Learn how to lend tokens for APY, borrow against collateral, and optimize yields using Kamino Lend, Multiply, and automated vault strategies.";
const canonical = 'https://dogeking.us/kamino-finance-lend-borrow-yield-solana-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>