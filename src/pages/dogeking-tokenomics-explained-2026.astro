---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/dogeking-tokenomics-explained-2026.html?raw';

const title = "DogeKing Tokenomics Explained: $DKING Supply, Burns \u0026 Distribution 2026";
const description = "Complete breakdown of DogeKing ($DKING) tokenomics — 1B total supply, 1% burn per transaction, 40% liquidity pool allocation, and how token distribution powers the Solana meme coin ecosystem.";
const canonical = 'https://dogeking.us/dogeking-tokenomics-explained-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>