---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/dogeking-roadmap-2026-whats-next.html?raw';

const title = "DogeKing Roadmap 2026 — What\u0027s Next for the Meme Coin Kingdom—";
const description = "Explore the DogeKing ($DKING) roadmap for 2026. Learn about upcoming exchange listings, NFT collection launches, staking rewards, community airdrops, and the expansion of the Solana meme coin ecosystem.";
const canonical = 'https://dogeking.us/dogeking-roadmap-2026-whats-next';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>