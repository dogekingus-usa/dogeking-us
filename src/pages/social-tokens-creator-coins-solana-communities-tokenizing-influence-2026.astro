---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/social-tokens-creator-coins-solana-communities-tokenizing-influence-2026.html?raw';

const title = "Social Tokens and Creator Coins on Solana: How Communities Are Tokenizing Influence in 2026 | DogeKing";
const description = "Explore the rise of social tokens and creator coins on Solana in 2026. Learn what they are, creator vs community coins, top platforms, fan tokens vs meme coins, evaluation frameworks, and the future of tokenized influence.";
const canonical = 'https://dogeking.us/social-tokens-creator-coins-solana-communities-tokenizing-influence-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>