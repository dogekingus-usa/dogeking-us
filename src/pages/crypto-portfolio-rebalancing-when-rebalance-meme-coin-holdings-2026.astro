---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-portfolio-rebalancing-when-rebalance-meme-coin-holdings-2026.html?raw';

const title = "Cryptocurrency Portfolio Rebalancing: How and When to Rebalance Your Meme Coin Holdings in 2026 | DogeKing";
const description = "Master cryptocurrency portfolio rebalancing for meme coins in 2026. Learn quarterly vs monthly frequency, threshold-based strategies, tax implications, profit-taking, and automated rebalancing tools for SOL, stablecoins, and meme coin portfolios.";
const canonical = 'https://dogeking.us/crypto-portfolio-rebalancing-when-rebalance-meme-coin-holdings-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>