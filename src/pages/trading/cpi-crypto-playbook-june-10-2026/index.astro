---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "cpi-crypto-playbook-june-10-2026", "title": "The CPI Crypto Playbook: 3 Moves Before Tomorrow's Inflation Report", "category": "trading", "date": "2026-06-09", "excerpt": "Bitcoin at $61K ahead of June 10 CPI report. A data-driven playbook for navigating volatility \u2014 including key levels to watch and strategic moves for crypto investors before the biggest macro event of the month.", "tags": ["trading", "macro", "bitcoin"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="The CPI Crypto Playbook: 3 Moves Before Tomorrow's Inflation Report" description="Bitcoin at $61K ahead of June 10 CPI report. A data-driven playbook for navigating volatility — including key levels to watch and strategic moves for crypto investors before the biggest macro event of the month.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">The CPI Crypto Playbook: 3 Moves Before Tomorrow's Inflation Report</h1>
      <time class="text-sm text-gray-500">2026-06-09</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">trading</span>
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">macro</span>
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">bitcoin</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Bitcoin at $61K ahead of June 10 CPI report. A data-driven playbook for navigating volatility — including key levels to watch and strategic moves for crypto investors before the biggest macro event of the month.</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
