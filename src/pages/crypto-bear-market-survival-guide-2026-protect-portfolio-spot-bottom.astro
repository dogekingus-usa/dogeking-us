---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-bear-market-survival-guide-2026-protect-portfolio-spot-bottom.html?raw';

const title = "Crypto Bear Market Survival Guide 2026: How to Protect Your Portfolio, Spot the Bottom \u0026 Prepare for the Next Bull Run";
const description = "Complete crypto bear market survival guide for 2026. Learn how to protect your portfolio during the downturn, spot the market bottom, dollar-cost average through fear, and position yourself for the next bull run. With Fear \u0026 Greed Index at 23 (extreme fear), now is the time for smart strategy.";
const canonical = 'https://dogeking.us/crypto-bear-market-survival-guide-2026-protect-portfolio-spot-bottom';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>