---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "top-meme-coins-2026", "title": "Doge King - Top 10 Meme Coins to Watch in 2026: Beyond Dogecoin - Shiba Inu, Pepe, Bonk, and Emerging Tokens", "category": "meme-coins", "date": "2026", "excerpt": "Live market data, community metrics, and risk analysis for the top 10 meme coins of 2026: Doge, Shiba, Pepe, Bonk, dogwifhat, and more. Real number...", "tags": ["meme-coins"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Doge King - Top 10 Meme Coins to Watch in 2026: Beyond Dogecoin - Shiba Inu, Pepe, Bonk, and Emerging Tokens" description="Live market data, community metrics, and risk analysis for the top 10 meme coins of 2026: Doge, Shiba, Pepe, Bonk, dogwifhat, and more. Real number...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Doge King - Top 10 Meme Coins to Watch in 2026: Beyond Dogecoin - Shiba Inu, Pepe, Bonk, and Emerging Tokens</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">meme-coins</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Live market data, community metrics, and risk analysis for the top 10 meme coins of 2026: Doge, Shiba, Pepe, Bonk, dogwifhat, and more. Real number...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
