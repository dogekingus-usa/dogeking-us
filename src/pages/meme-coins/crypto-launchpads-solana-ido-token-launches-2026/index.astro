---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "crypto-launchpads-solana-ido-token-launches-2026", "title": "Crypto Launchpads on Solana: How to Find and Participate in IDOs and Token Launches 2026 | DogeKing", "category": "meme-coins", "date": "2026", "excerpt": "Complete guide to Solana launchpads in 2026. Learn how to find, evaluate, and participate in IDOs and token launches on Jupiter LFG, Solanium, Trus...", "tags": ["meme-coins"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Crypto Launchpads on Solana: How to Find and Participate in IDOs and Token Launches 2026 | DogeKing" description="Complete guide to Solana launchpads in 2026. Learn how to find, evaluate, and participate in IDOs and token launches on Jupiter LFG, Solanium, Trus...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Crypto Launchpads on Solana: How to Find and Participate in IDOs and Token Launches 2026 | DogeKing</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">meme-coins</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Complete guide to Solana launchpads in 2026. Learn how to find, evaluate, and participate in IDOs and token launches on Jupiter LFG, Solanium, Trus...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
