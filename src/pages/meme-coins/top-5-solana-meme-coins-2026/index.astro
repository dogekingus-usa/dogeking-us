---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "top-5-solana-meme-coins-2026", "title": "Top 5 Solana Meme Coins to Watch in 2026: Community, Hype & Potential | DogeKing", "category": "meme-coins", "date": "2026", "excerpt": "Discover the top 5 Solana meme coins to watch in 2026. We analyze community strength, hype sustainability, and growth potential for BONK, WIF, $DKI...", "tags": ["meme-coins"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Top 5 Solana Meme Coins to Watch in 2026: Community, Hype & Potential | DogeKing" description="Discover the top 5 Solana meme coins to watch in 2026. We analyze community strength, hype sustainability, and growth potential for BONK, WIF, $DKI...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Top 5 Solana Meme Coins to Watch in 2026: Community, Hype & Potential | DogeKing</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">meme-coins</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Discover the top 5 Solana meme coins to watch in 2026. We analyze community strength, hype sustainability, and growth potential for BONK, WIF, $DKI...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
