---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "store", "title": "Products & Store \\u2014 dogeking.us", "category": "meme-coins", "date": "9770", "excerpt": "Premium digital products for dogeking.us. Boost your productivity, career, and financial success with our curated toolkit.", "tags": ["meme-coins"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Products & Store \u2014 dogeking.us" description="Premium digital products for dogeking.us. Boost your productivity, career, and financial success with our curated toolkit.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Products & Store \u2014 dogeking.us</h1>
      <time class="text-sm text-gray-500">9770</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">meme-coins</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Premium digital products for dogeking.us. Boost your productivity, career, and financial success with our curated toolkit.</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
