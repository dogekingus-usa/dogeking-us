---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "tax", "title": "Crypto Tax Guides 2026 \\u2014 Complete Tax Resource for Crypto Investors", "category": "meme-coins", "date": "2026", "excerpt": "Navigate crypto taxation with confidence. Expert guides on crypto tax reporting, portfolio tax tracking, meme coin tax strategies, and 2026 tax law...", "tags": ["meme-coins"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Crypto Tax Guides 2026 \u2014 Complete Tax Resource for Crypto Investors" description="Navigate crypto taxation with confidence. Expert guides on crypto tax reporting, portfolio tax tracking, meme coin tax strategies, and 2026 tax law...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Crypto Tax Guides 2026 \u2014 Complete Tax Resource for Crypto Investors</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">meme-coins</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Navigate crypto taxation with confidence. Expert guides on crypto tax reporting, portfolio tax tracking, meme coin tax strategies, and 2026 tax law...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
