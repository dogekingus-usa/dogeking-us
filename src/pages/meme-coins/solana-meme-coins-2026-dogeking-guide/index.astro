const article = {"slug": "solana-meme-coins-2026-dogeking-guide", "title": "Solana Meme Coins 2026: Complete Guide with DogeKing Analysis", "category": "meme-coins", "date": "2026", "excerpt": "Complete guide to Solana meme coins in 2026. Analysis of BONK, WIF, DOGEKING, and emerging tokens. Market trends, risks, and investment strategies ...", "tags": ["meme-coins"]};
