---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "top-5-crypto-wallets-meme-coins-2026", "title": "Top 5 Crypto Wallets for Meme Coins 2026 | DogeKing", "category": "meme-coins", "date": "2026", "excerpt": "The best crypto wallets for meme coins in 202\\u00ab. From Phantom to MetaMask, we review the top 5 wallets for Solana, Ethereum, and Base meme coins \\u2014 s...", "tags": ["meme-coins"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Top 5 Crypto Wallets for Meme Coins 2026 | DogeKing" description="The best crypto wallets for meme coins in 202\u00ab. From Phantom to MetaMask, we review the top 5 wallets for Solana, Ethereum, and Base meme coins \u2014 s...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Top 5 Crypto Wallets for Meme Coins 2026 | DogeKing</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">meme-coins</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>The best crypto wallets for meme coins in 202\u00ab. From Phantom to MetaMask, we review the top 5 wallets for Solana, Ethereum, and Base meme coins \u2014 s...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
