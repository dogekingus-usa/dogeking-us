---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "crypto-airdrop-guide-2026", "title": "Crypto Airdrop Guide 2026: How to Find and Claim Free Tokens | DogeKing.us", "category": "meme-coins", "date": "2026", "excerpt": "Complete crypto airdrop guide for 2026. Learn how to find legitimate airdrops, avoid scams, and maximize your free token claims.", "tags": ["meme-coins"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Crypto Airdrop Guide 2026: How to Find and Claim Free Tokens | DogeKing.us" description="Complete crypto airdrop guide for 2026. Learn how to find legitimate airdrops, avoid scams, and maximize your free token claims.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Crypto Airdrop Guide 2026: How to Find and Claim Free Tokens | DogeKing.us</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">meme-coins</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Complete crypto airdrop guide for 2026. Learn how to find legitimate airdrops, avoid scams, and maximize your free token claims.</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
