---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "social-tokens-creator-coins-solana-communities-tokenizing-influence-2026", "title": "Social Tokens and Creator Coins on Solana: How Communities Are Tokenizing Influence in 2026 | DogeKing", "category": "meme-coins", "date": "2026", "excerpt": "Explore the rise of social tokens and creator coins on Solana in 2026. Learn what they are, creator vs community coins, top platforms, fan tokens v...", "tags": ["meme-coins"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Social Tokens and Creator Coins on Solana: How Communities Are Tokenizing Influence in 2026 | DogeKing" description="Explore the rise of social tokens and creator coins on Solana in 2026. Learn what they are, creator vs community coins, top platforms, fan tokens v...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Social Tokens and Creator Coins on Solana: How Communities Are Tokenizing Influence in 2026 | DogeKing</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">meme-coins</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Explore the rise of social tokens and creator coins on Solana in 2026. Learn what they are, creator vs community coins, top platforms, fan tokens v...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
