---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const article = {"slug": "top-meme-coins-buy-june-2026", "title": "Top Meme Coins to Buy in June 2026: Best Tokens for Summer Rally", "category": "meme-coins", "date": "2026", "excerpt": "Discover the top meme coins to buy in June 2026. Expert analysis on PEPE, BONK, WIF, DOGEKING, and emerging Solana meme coins primed for the summer...", "tags": ["meme-coins"]};
const cat = article.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<BaseLayout title="Top Meme Coins to Buy in June 2026: Best Tokens for Summer Rally" description="Discover the top meme coins to buy in June 2026. Expert analysis on PEPE, BONK, WIF, DOGEKING, and emerging Solana meme coins primed for the summer...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Top Meme Coins to Buy in June 2026: Best Tokens for Summer Rally</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">meme-coins</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Discover the top meme coins to buy in June 2026. Expert analysis on PEPE, BONK, WIF, DOGEKING, and emerging Solana meme coins primed for the summer...</p>
    </div>
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide/" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>
