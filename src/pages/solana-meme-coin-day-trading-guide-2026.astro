---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/solana-meme-coin-day-trading-guide-2026.html?raw';

const title = "Day Trading Meme Coins on Solana: Complete Beginner\u0027s Guide 2026";
const description = "Master day trading meme coins on Solana in 2026. Learn 5 proven intraday strategies, entry/exit rules, risk management, and the best tools for scalping Solana meme coins for daily profits.";
const canonical = 'https://dogeking.us/solana-meme-coin-day-trading-guide-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>