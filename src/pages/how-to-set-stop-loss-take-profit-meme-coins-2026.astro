---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-set-stop-loss-take-profit-meme-coins-2026.html?raw';

const title = "How to Set Stop Loss and Take Profit Orders for Meme Coins in 2026: Complete Risk Management Guide";
const description = "Master stop loss and take profit orders for meme coin trading in 2026. Learn how to set stop losses on Solana DEXs and CEXs, trailing stops, strategic profit-taking levels, and position sizing to protect your crypto portfolio.";
const canonical = 'https://dogeking.us/how-to-set-stop-loss-take-profit-meme-coins-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>