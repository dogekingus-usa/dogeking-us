---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/top-5-solana-meme-coins-2026.html?raw';

const title = "Top 5 Solana Meme Coins to Watch in 2026: Community, Hype \u0026 Potential | DogeKing";
const description = "Discover the top 5 Solana meme coins to watch in 2026. We analyze community strength, hype sustainability, and growth potential for BONK, WIF, $DKING, POPCAT, and PENGU.";
const canonical = 'https://dogeking.us/top-5-solana-meme-coins-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>