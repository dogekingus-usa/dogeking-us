---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/dogeking-dking-token-complete-guide-meme-coin-royalty-solana-2026.html?raw';

const title = "DogeKing ($DKING) Token: Complete Guide to the Meme Coin Royalty on Solana in 2026 | DogeKing";
const description = "Complete guide to DogeKing ($DKING) token on Solana in 2026. Tokenomics, how to buy, roadmap, staking, utility, community, team, and why $DKING is the meme coin royalty. Everything you need to know about the DogeKing ecosystem.";
const canonical = 'https://dogeking.us/dogeking-dking-token-complete-guide-meme-coin-royalty-solana-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>