---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/solana-mobile-trade-meme-coins-phone-phantom-solflare-2026.html?raw';

const title = "Solana Mobile: How to Trade Meme Coins on Your Phone with Phantom Mobile and Solflare in 2026 | DogeKing";
const description = "Master Solana mobile meme coin trading in 2026. Full guide to Phantom Mobile, Solflare wallet, Jupiter DEX on mobile, Telegram bots, Solana Saga phone features, push notifications, and mobile security best practices.";
const canonical = 'https://dogeking.us/solana-mobile-trade-meme-coins-phone-phantom-solflare-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>