---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-security.html?raw';

const title = "Doge King - Crypto Security Guide 2026: Protect Your Assets from Hacks, Phishing, and Theft";
const description = "Complete crypto security guide covering 2FA, hardware wallets, seed phrase storage, phishing prevention, smart contract risks, and social engineering. \u003ca href=\"https://remoteworkhub.net/articles/avoid-burnout-while-working-from-home.html\" target=\"_blank\" rel=\"noopener";
const canonical = 'https://dogeking.us/crypto-security';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>