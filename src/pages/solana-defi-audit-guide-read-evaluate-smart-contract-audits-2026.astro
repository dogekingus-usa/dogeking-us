---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/solana-defi-audit-guide-read-evaluate-smart-contract-audits-2026.html?raw';

const title = "Solana DeFi Audit Guide: How to Read and Evaluate Smart Contract Audits Before Depositing Funds in 2026 | DogeKing";
const description = "Complete guide to reading and evaluating Solana DeFi smart contract audits in 2026. Learn what audits mean, top audit firms (Neodyme, OtterSec, Kudelski), how to interpret findings from critical to informational, audit completeness checklist, and how to assess protocols without audits.";
const canonical = 'https://dogeking.us/solana-defi-audit-guide-read-evaluate-smart-contract-audits-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>