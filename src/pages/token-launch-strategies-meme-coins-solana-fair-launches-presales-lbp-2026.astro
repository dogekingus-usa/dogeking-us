---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/token-launch-strategies-meme-coins-solana-fair-launches-presales-lbp-2026.html?raw';

const title = "Token Launch Strategies on Solana: Fair Launches, Presales, and LBP Explained in 2026 | DogeKing";
const description = "Complete guide to how meme coins launch on Solana. Fair launches vs presales, Liquidity Bootstrap Pools, whitelist systems, and how to evaluate token launches.";
const canonical = 'https://dogeking.us/token-launch-strategies-meme-coins-solana-fair-launches-presales-lbp-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>