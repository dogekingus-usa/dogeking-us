---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/dk-solana-cross-chain-bridge-guide-2026.html?raw';

const title = "Solana Cross-Chain Bridge Guide 2026: Move Tokens Between Solana, Ethereum, Base \u0026 Arbitrum | DogeKing";
const description = "Complete 2026 guide to Solana cross-chain bridges. Compare Wormhole, deBridge, Allbridge \u0026 Portal Bridge fees, speed \u0026 security. Step-by-step bridging tutorial for USDC, ETH, wBTC \u0026 SOL.";
const canonical = 'https://dogeking.us/dk-solana-cross-chain-bridge-guide-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>