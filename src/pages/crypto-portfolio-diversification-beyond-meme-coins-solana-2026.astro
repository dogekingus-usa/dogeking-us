---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-portfolio-diversification-beyond-meme-coins-solana-2026.html?raw';

const title = "Crypto Portfolio Diversification: Beyond Meme Coins — Building Long-Term Wealth on Solana | DogeKing";
const description = "Learn how to diversify your crypto portfolio beyond meme coins on Solana. DeFi lending, staking, RWA protocols, NFT strategies, and risk-balanced allocation models for long-term wealth in 2026.";
const canonical = 'https://dogeking.us/crypto-portfolio-diversification-beyond-meme-coins-solana-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>