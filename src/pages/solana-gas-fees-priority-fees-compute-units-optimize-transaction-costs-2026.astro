---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/solana-gas-fees-priority-fees-compute-units-optimize-transaction-costs-2026.html?raw';

const title = "Solana Gas Fees Explained: Priority Fees, Compute Units, and How to Optimize Transaction Costs in 2026";
const description = "Complete guide to Solana gas fees in 2026. Learn how base fees, priority fees, and compute units work together. Master fee optimization strategies, use Jupiter for low-cost swaps, and compare Solana fees to Ethereum L2s.";
const canonical = 'https://dogeking.us/solana-gas-fees-priority-fees-compute-units-optimize-transaction-costs-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>