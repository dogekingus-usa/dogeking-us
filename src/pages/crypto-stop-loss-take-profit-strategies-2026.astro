---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-stop-loss-take-profit-strategies-2026.html?raw';

const title = "Crypto Stop Loss and Take Profit Strategies: Protect Your Meme Coin Profits in Volatile Markets | DogeKing";
const description = "Master crypto stop loss and take profit strategies for meme coins in 2026. Learn position sizing, trailing stops, partial profit-taking, and risk management techniques used by pro traders.";
const canonical = 'https://dogeking.us/crypto-stop-loss-take-profit-strategies-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>