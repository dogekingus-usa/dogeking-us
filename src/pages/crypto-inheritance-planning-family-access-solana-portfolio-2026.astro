---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-inheritance-planning-family-access-solana-portfolio-2026.html?raw';

const title = "Cryptocurrency Inheritance Planning: How to Ensure Your Family Can Access Your Solana Portfolio in 2026 | DogeKing";
const description = "Complete guide to cryptocurrency inheritance planning for Solana portfolios in 2026. Learn about multisig wallets, dead man\u0027s switches, social recovery, seed phrase wills, legal considerations, and trusted third-party services to ensure your family can access your crypto assets.";
const canonical = 'https://dogeking.us/crypto-inheritance-planning-family-access-solana-portfolio-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>