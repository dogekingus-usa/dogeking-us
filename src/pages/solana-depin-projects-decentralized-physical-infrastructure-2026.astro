---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/solana-depin-projects-decentralized-physical-infrastructure-2026.html?raw';

const title = "Solana DePIN Projects 2026: Complete Guide to Decentralized Physical Infrastructure Networks on Solana";
const description = "Complete guide to Solana DePIN (Decentralized Physical Infrastructure Networks) projects in 2026. Learn about Hivemapper, Helium, Render Network, and how to invest in the infrastructure revolution on Solana.";
const canonical = 'https://dogeking.us/solana-depin-projects-decentralized-physical-infrastructure-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>