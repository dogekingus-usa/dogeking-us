---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/crypto-support-resistance-levels-trading-guide-2026.html?raw';

const title = "Crypto Support and Resistance Levels: Complete Trading Guide 2026";
const description = "Master crypto support and resistance trading in 2026. Learn to identify key levels, draw accurate trend lines, spot breakouts and reversals, and build a complete S/R trading strategy for meme coins and altcoins.";
const canonical = 'https://dogeking.us/crypto-support-resistance-levels-trading-guide-2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>