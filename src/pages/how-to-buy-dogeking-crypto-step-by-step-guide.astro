---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-buy-dogeking-crypto-step-by-step-guide.html?raw';

const title = "How to Buy DogeKing ($DKING) Crypto: Step-by-Step Guide 2026 | DogeKing";
const description = "Complete step-by-step guide on how to buy DogeKing ($DKING) crypto in 2026. Use Binance for the best rates, secure with Ledger, and grab the DogeKing Crypto Bundle.";
const canonical = 'https://dogeking.us/how-to-buy-dogeking-crypto-step-by-step-guide';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'DogeKing.us' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/crypto-guide" text="Explore More Guides" variant="secondary" />
    </div>
  </article>
</BaseLayout>