---
// EmailCapture.astro — article-footer + homepage email capture (CTO build 2026-08-05)
// Per EMAIL-CAPTURE-DEPLOYMENT-PLAN §4: one per page view, article footers + homepage.
// Posts to /api/subscribe (Cloudflare edge route -> fleet-email-subscribe worker).
// Excluded on utility pages (about/contact/legal/hub/redirect/etc.).
// v2 (2026-08-08 tailwind-specialist): inline raw hexes → token utilities (canary #5 fix)
const SITE_SLUG = "dogeking";
const MAGNET_NAME = "Crypto Starter Guide";
const VALUE_PROP = "Get the free Crypto Starter Guide — Solana & meme coin trading fundamentals in one clean page.";
const DOWNLOAD_URL = "/downloads/crypto-starter-guide.html";

const path = (Astro.url.pathname || "/").replace(/\.html$/, "").replace(/\/$/, "") || "/";
const EXCLUDE = [
  "/about", "/contact", "/privacy", "/privacy-policy", "/terms", "/terms-of-service",
  "/disclaimer", "/affiliate-disclosure", "/all-articles", "/checklist", "/crypto-guide",
  "/tools-comparison", "/thank-you", "/lead-magnet", "/downloads", "/category", "/l/",
  "/short", "/digital-products", "/og-images", "/assets", "/sitemap", "/feed",
  "/404", "/crypto-guide",
];
const excluded = EXCLUDE.some((p) => path === p || path.startsWith(p + "/") || path.startsWith(p));
if (excluded) return;
---

<div class="email-capture bg-gray-50 border border-gray-200 rounded-lg text-center mx-auto my-8 max-w-2xl p-6">
  <h3 class="text-navy-950 font-semibold text-lg mb-2 mt-0">Get the Free {MAGNET_NAME}</h3>
  <p class="text-gray-700 text-sm mb-4 mt-0">{VALUE_PROP}</p>
  <form class="email-capture-form" action="/api/subscribe" method="POST" data-site={SITE_SLUG}>
    <input type="email" name="email" placeholder="Your email address" required
           class="w-3/5 max-w-xs px-3.5 py-2.5 border border-gray-300 rounded-md text-navy-950" />
    <button type="submit" class="px-5 py-2.5 bg-navy-950 text-white font-semibold rounded-md border-0 cursor-pointer">
      Get It Free →
    </button>
  </form>
  <p class="text-gray-500 text-xs mt-2 mb-0">No spam. Unsubscribe anytime.</p>
  <p class="email-capture-msg text-state-success text-sm hidden mt-2 mb-0"></p>
</div>

<script is:inline>
(function () {
  document.querySelectorAll(".email-capture-form").forEach(function (form) {
    form.addEventListener("submit", async function (ev) {
      ev.preventDefault();
      var email = form.querySelector('input[name="email"]').value.trim();
      var site = form.getAttribute("data-site");
      var box = form.closest(".email-capture");
      var msg = box.querySelector(".email-capture-msg");
      var btn = form.querySelector("button");
      btn.disabled = true;
      btn.textContent = "Sending…";
      try {
        var resp = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email, site: site, source: "article-footer" }),
        });
        var data = await resp.json();
        if (data.ok) {
          form.style.display = "none";
          msg.textContent = "✓ Check your inbox!";
          msg.classList.remove("text-state-error");
          msg.classList.add("text-state-success");
          msg.style.display = "block";
          if (typeof gtag === "function") {
            gtag("event", "generate_lead", { site: site, source: "article-footer" });
          }
        } else if (resp.status === 409) {
          msg.textContent = "You're already subscribed — check your inbox!";
          msg.classList.remove("text-state-error");
          msg.classList.add("text-state-success");
          msg.style.display = "block";
          btn.disabled = false;
          btn.textContent = "Get It Free →";
        } else {
          msg.textContent = "Something went wrong. Please try again.";
          msg.classList.add("text-state-error");
          msg.classList.remove("text-state-success");
          msg.style.display = "block";
          btn.disabled = false;
          btn.textContent = "Get It Free →";
        }
      } catch (e) {
        msg.textContent = "Network error. Please try again.";
        msg.classList.add("text-state-error");
        msg.classList.remove("text-state-success");
        msg.style.display = "block";
        btn.disabled = false;
        btn.textContent = "Get It Free →";
      }
    });
  });
})();
</script>
