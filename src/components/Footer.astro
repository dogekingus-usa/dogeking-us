---
export interface Props {
  siteTitle?: string;
}

const { siteTitle = 'DogeKing' } = Astro.props;
---

<footer class="border-t border-gray-800 bg-dark-800 py-8">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-sm text-gray-400">
      <div>
        <h3 class="font-heading text-brand-500 mb-3 font-semibold">{siteTitle}</h3>
        <p>Your guide to meme coin trading on Solana.</p>
      </div>
      <div>
        <h4 class="text-gray-200 mb-3 font-medium">Quick Links</h4>
        <ul class="space-y-2">
          <li><a href="/all-articles/" class="hover:text-brand-500 transition">All Articles</a></li>
          <li><a href="/crypto-guide/" class="hover:text-brand-500 transition">Crypto Guide</a></li>
          <li><a href="/about/" class="hover:text-brand-500 transition">About</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-gray-200 mb-3 font-medium">Resources</h4>
        <ul class="space-y-2">
          <li><a href="/checklist/" class="hover:text-brand-500 transition">Checklist</a></li>
          <li><a href="/tools-comparison/" class="hover:text-brand-500 transition">Tools</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-gray-200 mb-3 font-medium">Legal</h4>
        <ul class="space-y-2">
          <li><a href="/privacy/" class="hover:text-brand-500 transition">Privacy</a></li>
          <li><a href="/terms/" class="hover:text-brand-500 transition">Terms</a></li>
          <li><a href="/disclaimer/" class="hover:text-brand-500 transition">Disclaimer</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-8 border-t border-gray-800 pt-6 text-center text-xs text-gray-500">
      &copy; {new Date().getFullYear()} {siteTitle}. All rights reserved.
    </div>
  </div>
</footer>
