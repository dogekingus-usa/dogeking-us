---
// BaseLayout.astro — shared head, meta, fonts, header, footer (Phase 1.2)
// Consumes the shared component library (Header/Footer/NewsletterForm).
// G3 landmarks: header→banner, nav→navigation, main→main, footer→contentinfo.
// Skip-link first focusable (rendered by Header.astro).
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { site } from '../config/site';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  showNewsletter?: boolean;
}

const { title, description, image, canonical, showNewsletter = true } = Astro.props;
const siteTitle = site.name;
// Dedupe: if the page title equals the site title (dash-normalized), render it once.
const norm = (s: string) => s.replace(/[\u2014\u2013]/g, '-').trim().toLowerCase();
const fullTitle = title && norm(title) !== norm(siteTitle) ? `${title} | ${siteTitle}` : siteTitle;
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonicalUrl = canonical || `${site.url}${cleanPath}`;
const ogImage = image || `${site.url}/assets/og-image.svg`;
---

<!doctype html>
<html lang="en" class="theme-dogeking">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Crown design system (legacy article content styling) -->
    <link rel="stylesheet" href="/crown-design-system.css" />

    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  </head>
  <body class="bg-surface text-ink font-body">
    <Header site={site} currentPath={Astro.url.pathname} />

    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <slot />
    </main>

    {showNewsletter ? <NewsletterForm site={site} /> : null}

    <Footer site={site} currentPath={Astro.url.pathname} />
  </body>
</html>
