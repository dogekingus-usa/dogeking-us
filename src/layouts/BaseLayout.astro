---
// BaseLayout.astro — shared head, meta, fonts, header, footer
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
}

const { title, description, image, canonical } = Astro.props;
const siteTitle = 'DogeKing — Meme Coin Trading Guides';
const fullTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonicalUrl = canonical || `https://dogeking.us${cleanPath}`;
const ogImage = image || 'https://dogeking.us/assets/og-image.svg';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="theme-dogeking">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Crown design system (legacy article content styling) -->
    <link rel="stylesheet" href="/crown-design-system.css" />

    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  </head>
  <body class="bg-dark-900 text-gray-100 font-body">
    <header class="sticky top-0 z-50 border-b border-brand-500/15 bg-dark-900/95 backdrop-blur-sm">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2 font-heading text-xl font-bold text-brand-500">
          <img src="/assets/crown-logo.svg" alt="DogeKing" class="h-8 w-8" />
          <span>DogeKing</span>
        </a>
        <ul class="hidden md:flex gap-6 text-sm font-medium text-gray-300">
          <li><a href="/" class="transition hover:text-brand-500">Home</a></li>
          <li><a href="/crypto-guide" class="transition hover:text-brand-500">Crypto Guide</a></li>
          <li><a href="/all-articles" class="transition hover:text-brand-500">Articles</a></li>
          <li><a href="/about" class="transition hover:text-brand-500">About</a></li>
        </ul>
        <button
          id="nav-toggle"
          class="md:hidden rounded-md border border-brand-500/30 p-2 text-brand-500"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        </button>
      </nav>
      <div id="nav-panel" class="hidden md:hidden border-t border-brand-500/10 bg-dark-800 px-4 py-3">
        <ul class="flex flex-col gap-3 text-sm font-medium text-gray-300">
          <li><a href="/" class="nav-mobile-link block py-2 transition hover:text-brand-500">Home</a></li>
          <li><a href="/crypto-guide" class="nav-mobile-link block py-2 transition hover:text-brand-500">Crypto Guide</a></li>
          <li><a href="/all-articles" class="nav-mobile-link block py-2 transition hover:text-brand-500">Articles</a></li>
          <li><a href="/about" class="nav-mobile-link block py-2 transition hover:text-brand-500">About</a></li>
        </ul>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-brand-500/15 bg-dark-900 py-8">
      <div class="mx-auto max-w-6xl px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-sm text-gray-400">
          <div>
            <div class="mb-3 flex items-center gap-2 font-heading text-lg font-bold text-brand-500">
              <img src="/assets/crown-logo.svg" alt="DogeKing" class="h-6 w-6" />
              <span>DogeKing</span>
            </div>
            <p>Your guide to meme coin trading on Solana — curated guides, tools, and systems to help you level up.</p>
          </div>
          <div>
            <h4 class="mb-3 font-medium text-gray-200">Guides</h4>
            <ul class="space-y-2">
              <li><a href="/crypto-guide" class="transition hover:text-brand-500">Crypto Guide</a></li>
              <li><a href="/all-articles" class="transition hover:text-brand-500">All Articles</a></li>
              <li><a href="/checklist" class="transition hover:text-brand-500">Checklist</a></li>
            </ul>
          </div>
          <div>
            <h4 class="mb-3 font-medium text-gray-200">Resources</h4>
            <ul class="space-y-2">
              <li><a href="/tools-comparison" class="transition hover:text-brand-500">Tools</a></li>
              <li><a href="/about" class="transition hover:text-brand-500">About</a></li>
              <li><a href="/contact" class="transition hover:text-brand-500">Contact</a></li>
            </ul>
          </div>
          <div>
            <h4 class="mb-3 font-medium text-gray-200">Legal</h4>
            <ul class="space-y-2">
              <li><a href="/privacy" class="transition hover:text-brand-500">Privacy</a></li>
              <li><a href="/terms-of-service" class="transition hover:text-brand-500">Terms</a></li>
              <li><a href="/disclaimer" class="transition hover:text-brand-500">Disclaimer</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-8 flex flex-col items-center gap-2 border-t border-brand-500/10 pt-6 text-center text-xs text-gray-500 md:flex-row md:justify-between">
          <div>
            &copy; {year} DogeKing. All rights reserved. <span class="text-gray-600">— Not financial advice. DYOR.</span>
          </div>
          <div class="flex gap-4">
            <a href="https://x.com/DogeKingCoin" class="transition hover:text-brand-500" rel="noopener" target="_blank">X</a>
            <a href="https://t.me/DogeKing" class="transition hover:text-brand-500" rel="noopener" target="_blank">Telegram</a>
            <a href="https://discord.gg/DogeKing" class="transition hover:text-brand-500" rel="noopener" target="_blank">Discord</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('nav-toggle');
      const panel = document.getElementById('nav-panel');
      if (toggle && panel) {
        toggle.addEventListener('click', () => {
          const open = panel.classList.toggle('hidden') === false;
          toggle.setAttribute('aria-expanded', String(open));
        });
        panel.querySelectorAll('.nav-mobile-link').forEach((link) => {
          link.addEventListener('click', () => {
            panel.classList.add('hidden');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      }
    </script>
  </body>
</html>
